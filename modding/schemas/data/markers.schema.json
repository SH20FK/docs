{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "data/markers.json",
 "description": "Выведено из данных игры утилитой tools/modding/страж.py. Патч: data/markers.json → data/markers.patch.json",
 "type": "object",
 "properties": {
  "marks": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "lat": {
      "type": "number"
     },
     "lon": {
      "type": "number"
     },
     "type": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     }
    }
   }
  }
 }
}