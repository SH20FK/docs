     "wealth": {
      "type": "object",
      "properties": {
       "energy": {
        "type": "number"
       },
       "materials": {
        "type": "number"
       },
       "water": {
        "type": "number"
       },
       "rare": {
        "type": "number"
       },
       "food": {
        "type": "number"
       },
       "fuel": {
        "type": "number"
       }
      }
     },
     "colony": {
      "type": "string"
     }
    }
   },
   "x-examples": [
    "Солнце",
    "Меркурий",
    "Венера",
    "Земля",
    "Луна"
   ]
